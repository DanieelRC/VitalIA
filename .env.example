# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (para enlaces de invitación)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- xAI / Grok (solo servidor) ---
XAI_API_KEY=
XAI_MODEL_PATIENT=grok-4.20-0309-non-reasoning
XAI_MODEL_PRO=grok-4.20-0309-non-reasoning
# Precios en USD por millón de tokens: JSON {"modelo": {"input": x, "output": y}}
# Verifícalos en https://docs.x.ai antes de producción; sirven para calcular el gasto.
XAI_PRICES={"grok-4.20-0309-non-reasoning":{"input":1.25,"output":2.5},"grok-build-0.1":{"input":1,"output":2},"grok-4.3":{"input":1.25,"output":2.5},"grok-4.7":{"input":2,"output":6}}

# --- Correo (confirmación de registro, recordatorios, avisos) ---
# Opción A: SMTP con una cuenta de Gmail DEDICADA a VitalIA (no la personal). Requiere verificación en dos pasos
# y una «contraseña de aplicación» (Cuenta de Google → Seguridad). Si SMTP_USER y SMTP_PASSWORD están definidas, se usa esta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Opción B: Resend (requiere un dominio propio verificado en Resend)
RESEND_API_KEY=
# Remitente. Con Gmail debe ser la misma cuenta (p. ej. VitalIA <vitalia.avisos@gmail.com>); si se omite, se usa SMTP_USER.
EMAIL_FROM=

# --- Cron (Vercel Cron envía Authorization: Bearer CRON_SECRET) ---
CRON_SECRET=

# --- Notificaciones push: genera las llaves con  npx web-push generate-vapid-keys ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@correo.com

# --- Cobro de suscripciones (Stripe) ---
# Usa llaves de PRUEBA (sk_test_...). Las llaves live se ignoran salvo que definas BILLING_ALLOW_LIVE=1.
STRIPE_SECRET_KEY=
# En local: `stripe listen --forward-to localhost:3000/api/webhooks/stripe` imprime el whsec_...
# En producción: Dashboard → Developers → Webhooks, con los eventos checkout.session.completed,
# customer.subscription.created/updated/deleted, invoice.paid e invoice.payment_failed.
STRIPE_WEBHOOK_SECRET=
BILLING_ALLOW_LIVE=

# --- Facturación CFDI 4.0 (Facturapi) ---
# Llave secreta de la organización emisora (sk_test_... en modo prueba).
FACTURAPI_KEY=
